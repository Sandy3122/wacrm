# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
# Must match the project linked via: npx supabase link --project-ref <ref>
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database password for CLI migrations (Project Settings → Database).
# Required for: npm run db:setup / npm run db:push
SUPABASE_DB_PASSWORD=your-database-password

# Optional: full Postgres URL override (copy Session pooler URI from Dashboard).
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: AWS region for session pooler when direct db.<ref>.supabase.co fails
# (IPv6-only / "no route to host"). Copy the exact host from Dashboard → Database
# → Connection string → Session (may be aws-0-*, aws-1-*, etc.).
# SUPABASE_DB_REGION=ap-south-1
# SUPABASE_DB_POOLER_HOST=aws-1-ap-south-1.pooler.supabase.com

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook and automation engine). Keep this secret —
# never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# Embedded Signup (Coexistence) — required only for in-app Meta onboarding.
# Meta App Dashboard → WhatsApp → Embedded Signup → Configuration ID.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap, OG images, and any email the app
# sends. Defaults to https://connect.softivum.com if unset.
NEXT_PUBLIC_SITE_URL=https://connect.softivum.com

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Contact form (POST /api/contact) — Nodemailer SMTP delivery.
# If any required SMTP value is missing, submissions are accepted and
# logged server-side but no email is sent (fine for local dev / demos).
CONTACT_TO_EMAIL=contact@softivum.com
CONTACT_FROM_EMAIL="Softivum Connect <no-reply@softivum.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# true for port 465 (implicit TLS); false or unset for 587 + STARTTLS.
# SMTP_SECURE=false

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# The same AUTOMATION_CRON_SECRET also protects the webhook replay
# endpoint (POST /api/whatsapp/webhook/replay), which re-processes
# failed raw_webhook_events. Point a scheduler at it (e.g. every
# 5 min) with `Authorization: Bearer <AUTOMATION_CRON_SECRET>` to
# auto-recover from transient downstream failures. See
# docs/multi-tenant-and-providers.md.
